# Copy to .env (or set these in your hosting dashboard).

# Port the server listens on.
PORT=3000

# Shared PIN both of you type once in the app. Leave empty to disable auth (local testing only).
APP_PIN=1234

# Web Push (browser/phone notifications). Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: also send every notification to a Telegram chat.
# 1) Talk to @BotFather -> /newbot -> copy the token.
# 2) Message your new bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daily reminder of still-open high/urgent wishes (hour 0-23 in the server's timezone). Empty = off.
REMINDER_HOUR=9

# Where items.json / subscriptions.json live. Point this at a persistent disk on your host.
DATA_DIR=./data
